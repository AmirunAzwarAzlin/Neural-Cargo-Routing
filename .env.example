SUPABASE_URL=
SUPABASE_SERVICE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CLASSIFY_FALLBACK=true
ENABLE_TRANSACTION_VERIFICATION=false
DASHBOARD_PASSWORD=
ALLOW_NO_AUTH=false
# Random secret used to sign session/CSRF tokens. Required whenever
# DASHBOARD_PASSWORD is set. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
DATA_DIR=data
